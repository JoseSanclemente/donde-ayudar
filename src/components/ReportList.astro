---
import { DEFAULT_LIST_FILTER, LIST_FILTERS } from "../scripts/status";
import { CHIP_OFF, chipOnClass } from "../scripts/resources";
import { CARET } from "../scripts/ui/select";
---

<section id="report-card" data-panel-card class="border-b border-slate-200 pb-5 pt-3">
  <div class="flex items-baseline justify-start gap-2">
    <h2 class="text-lg font-semibold text-slate-900">Zonas reportadas</h2>
    <span
      id="report-count"
      class="rounded-full border border-slate-600 bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">0</span
    >
    <span
      id="report-urgent"
      class="hidden rounded-full border border-red-700 bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700"
    ></span>

    <!-- Only on desktop: on mobile «Puntos» is a whole tab of the sheet, and a
         tab that hides its own list would be a tab with nothing in it. -->
    <button
      type="button"
      id="report-toggle"
      aria-expanded="false"
      aria-controls="report-card-body"
      aria-label="Mostrar u ocultar la lista de zonas"
      class="ml-auto hidden shrink-0 rounded-lg p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 lg:inline-flex"
    >
      <span id="report-caret" aria-hidden="true">{CARET}</span>
    </button>
  </div>

  <div id="report-card-body" data-card-body>
    <div id="report-filter" class="mt-3 flex flex-wrap gap-1.5">
      {
        LIST_FILTERS.map((filter) => (
          <button
            type="button"
            data-list-filter={filter.id ?? ""}
            aria-pressed={filter.id === DEFAULT_LIST_FILTER ? "true" : "false"}
            class={
              filter.id === DEFAULT_LIST_FILTER ? chipOnClass(undefined) : CHIP_OFF
            }
          >
            {filter.label}
          </button>
        ))
      }
    </div>

    <p id="empty-state" class="mt-3 text-sm text-slate-500">Aún no hay reportes.</p>

    <ul id="report-list" class="mt-3 space-y-3"></ul>
  </div>
</section>
