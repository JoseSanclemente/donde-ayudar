---
import { LIST_FILTERS } from "../scripts/status";
import { CHIP_OFF, chipOnClass } from "../scripts/resources";
---

<section class="border-b border-slate-200 pb-5 pt-3">
  <div class="flex items-baseline justify-start gap-2">
    <h2 class="text-lg font-semibold text-slate-900">Zonas reportadas</h2>
    <span
      id="report-count"
      class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700">0</span
    >
  </div>

  <p id="report-summary" class="mt-1 text-xs text-slate-500"></p>

  <div id="report-filter" class="mt-3 flex flex-wrap gap-1.5">
    {
      LIST_FILTERS.map((filter, index) => (
        <button
          type="button"
          data-list-filter={filter.id ?? ""}
          aria-pressed={index === 0 ? "true" : "false"}
          class={index === 0 ? chipOnClass(undefined) : CHIP_OFF}
        >
          {filter.label}
        </button>
      ))
    }
  </div>

  <p id="empty-state" class="mt-3 text-sm text-slate-500">Aún no hay reportes.</p>

  <ul id="report-list" class="mt-3 space-y-3"></ul>
</section>
