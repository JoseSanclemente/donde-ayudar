<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-baseline justify-between">
    <h2 class="text-base font-semibold text-slate-900">Edificios reportados</h2>
    <span
      id="report-count"
      class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700">0</span
    >
  </div>

  <p id="empty-state" class="mt-3 text-sm text-slate-500">
    Aún no hay reportes.
  </p>

  <ul id="report-list" class="mt-3 space-y-3"></ul>
</section>
