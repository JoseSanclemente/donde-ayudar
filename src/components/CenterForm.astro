---
import LocationField from "./LocationField.astro";
import ResourcePicker from "./ResourcePicker.astro";
---

<form id="center-form" novalidate class="space-y-5">
  <p class="text-sm text-slate-500">
    Un sitio que está recibiendo donaciones: una bodega, un parqueadero, un colegio.
  </p>

  <div>
    <label for="center-point-name" class="block text-sm font-medium text-slate-700">
      Nombre del punto
    </label>
    <input
      id="center-point-name"
      type="text"
      autocomplete="off"
      maxlength="120"
      placeholder="Ej. Coliseo del Pueblo"
      class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
    />
    <p id="center-point-name-error" class="mt-1 hidden text-xs font-medium text-red-600"></p>
  </div>

  <div>
    <LocationField
      prefix="center"
      label="Dirección"
      placeholder="Ej. Cll 9 # 34 - 01, Cali"
    />
  </div>

  <div>
    <label for="center-hours" class="block text-sm font-medium text-slate-700">
      Horario <span class="font-normal text-slate-400">(opcional)</span>
    </label>
    <input
      id="center-hours"
      type="text"
      autocomplete="off"
      maxlength="120"
      placeholder="Ej. Lun a sáb, 8:00 a. m. – 6:00 p. m."
      class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
    />
  </div>

  <!-- Item by item, the same catalog a need is asked with: a point that only
       takes nappies must not publish as if it took the whole category. -->
  <ResourcePicker
    prefix="center"
    label="¿Qué está recibiendo?"
    hint="Déjalo vacío si todavía no saben qué van a necesitar."
  />

  <div>
    <label for="center-whatsapp" class="block text-sm font-medium text-slate-700">
      WhatsApp <span class="font-normal text-slate-400">(opcional)</span>
    </label>
    <input
      id="center-whatsapp"
      type="tel"
      maxlength="20"
      autocomplete="off"
      placeholder="Ej. 310 123 4567"
      class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
    />
    <p id="center-whatsapp-error" class="mt-1 hidden text-xs font-medium text-red-600"></p>

    <label for="center-instagram" class="mt-4 block text-sm font-medium text-slate-700">
      Instagram <span class="font-normal text-slate-400">(opcional)</span>
    </label>
    <input
      id="center-instagram"
      type="text"
      maxlength="40"
      autocomplete="off"
      placeholder="Ej. @alcaldiadecali"
      class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
    />
    <p id="center-instagram-error" class="mt-1 hidden text-xs font-medium text-red-600"></p>

    <!-- The same blue notice as the other two forms: publishing a contact is
         the same decision in all of them. -->
    <div
      class="mt-2 flex items-start gap-2 rounded-lg border border-blue-200 bg-blue-50 p-3 text-xs font-medium text-blue-700"
    >
      <svg
        viewBox="0 0 20 20"
        aria-hidden="true"
        class="mt-0.5 h-4 w-4 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="10" cy="10" r="7.5"></circle>
        <path d="M10 9.2v4.3"></path>
        <path d="M10 6.6v.1"></path>
      </svg>
      <p>Se muestra públicamente en el mapa.</p>
    </div>
  </div>

  <div>
    <label for="center-notes" class="block text-sm font-medium text-slate-700">
      Nota <span class="font-normal text-slate-400">(opcional)</span>
    </label>
    <textarea
      id="center-notes"
      rows="2"
      maxlength="300"
      placeholder="Ej: entrada por la portería norte; no reciben ropa usada."
      class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
    ></textarea>
  </div>

  <div
    class="flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800"
  >
    <p>
      El punto aparece en el mapa de inmediato, marcado como <span class="font-semibold"
        >«Creado por la comunidad»</span
      >. Regístralo solo si sabes que está recibiendo.
    </p>
  </div>

  <button
    type="submit"
    class="w-full rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300"
  >
    Registrar punto
  </button>
</form>

<style>
  /* No text, no error to show; the margin of an invisible one shows anyway. */
  #center-point-name-error:empty,
  #center-whatsapp-error:empty,
  #center-instagram-error:empty {
    display: none;
  }
</style>
