---
import { CATEGORIES, CHIP_OFF } from "../scripts/resources";
import LocationField from "./LocationField.astro";
---

<form id="report-form" novalidate class="space-y-5">
  <div>
    <LocationField prefix="report" label="Dirección" placeholder="Ej. Cra 56 #3-88" />
  </div>

  <!-- Recursos -->
  <div>
    <span class="block text-sm font-medium text-slate-700">
      Insumos necesarios
    </span>
    <div id="preset-chips" class="mt-2 space-y-2">
      {
        CATEGORIES.map((category) => (
          <details
            data-category={category.id}
            class="overflow-hidden rounded-lg border border-slate-200"
          >
            <summary
              class={`flex cursor-pointer list-none items-center gap-2 px-3 py-2 text-sm font-medium transition hover:brightness-95 ${category.chip}`}
            >
              <span class="caret opacity-60 transition-transform">▸</span>
              <span class="flex-1">{category.label}</span>
              <span data-count={category.id} class="text-xs opacity-70">
                {category.items.length}
              </span>
            </summary>
            <div class="flex flex-wrap gap-2 px-3 py-3">
              {category.items.map((item) => (
                <button
                  type="button"
                  data-preset={item}
                  data-category={category.id}
                  aria-pressed="false"
                  class={CHIP_OFF}
                >
                  {item}
                </button>
              ))}
            </div>
          </details>
        ))
      }
    </div>

    <div id="selected-resources" class="mt-3 flex flex-wrap gap-2"></div>
    <p id="resources-error" class="mt-1 hidden text-xs font-medium text-red-600"></p>
  </div>

  <div>
    <label for="note" class="block text-sm font-medium text-slate-700">
      Nota <span class="font-normal text-slate-400">(opcional)</span>
    </label>
    <textarea
      id="note"
      rows="2"
      maxlength="200"
      placeholder="Ej: ya hay suficiente comida; faltan cascos y linternas para la noche."
      class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
    ></textarea>
    <p class="mt-1 text-right text-[11px] text-slate-400"><span id="note-count">0</span>/200</p>
  </div>

  <div>
    <label for="contact-name" class="block text-sm font-medium text-slate-700">
      Contacto en el punto <span class="font-normal text-slate-400">(opcional)</span>
    </label>
    <div class="mt-1.5 grid grid-cols-2 gap-2">
      <input
        id="contact-name"
        type="text"
        maxlength="60"
        autocomplete="off"
        placeholder="Nombre"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
      />
      <input
        id="contact-phone"
        type="tel"
        maxlength="20"
        autocomplete="off"
        placeholder="Teléfono"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
      />
    </div>
    <p id="contact-error" class="mt-1 hidden text-xs font-medium text-red-600"></p>

    <!-- Mismo aviso azul que en «¿Tienes algo para donar?»: publicar un teléfono
         es la misma decisión en los dos formularios, así que se ve igual. -->
    <div
      class="mt-2 flex items-start gap-2 rounded-lg border border-blue-200 bg-blue-50 p-3 text-xs font-medium text-blue-700"
    >
      <svg
        viewBox="0 0 20 20"
        aria-hidden="true"
        class="mt-0.5 h-4 w-4 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="10" cy="10" r="7.5"></circle>
        <path d="M10 9.2v4.3"></path>
        <path d="M10 6.6v.1"></path>
      </svg>
      <p>Se muestra públicamente en el mapa.</p>
    </div>
  </div>

  <label
    class="flex cursor-pointer items-start gap-2 rounded-lg border border-slate-200 bg-slate-50 p-3"
  >
    <input
      id="urgente"
      type="checkbox"
      class="mt-0.5 h-4 w-4 shrink-0 rounded border-slate-300 text-red-600 focus:ring-red-300"
    />
    <span class="text-xs text-slate-700">
      <span class="font-semibold text-slate-900">Es urgente.</span> Hay gente atrapada o
      se necesita ayuda ya. Cualquiera puede cambiarlo después.
    </span>
  </label>

  <button
    type="submit"
    class="w-full rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300"
  >
    Realizar reporte
  </button>
</form>

<style>
  /* Safari sigue pintando el triángulo nativo aunque `list-none` esté puesto. */
  summary::-webkit-details-marker {
    display: none;
  }

  details[open] > summary .caret {
    transform: rotate(90deg);
  }

  /* Sin texto no hay error que mostrar. `clearError` ya pone la clase `hidden`,
     pero el hueco tampoco debe aparecer si alguna vez se vacía el párrafo sin
     pasar por ahí — el margen de un error invisible se ve igual. */
  #resources-error:empty,
  #contact-error:empty {
    display: none;
  }
</style>
