---
import { CATEGORIES, CHIP_OFF } from "../scripts/resources";
---

<form
  id="report-form"
  novalidate
  class="space-y-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
>
  <div>
    <h2 class="text-base font-semibold text-slate-900">Reportar un edificio</h2>
    <p class="mt-1 text-sm text-slate-500">
      Indica el edificio afectado y qué recursos necesita.
    </p>
  </div>

  <!-- Nombre / dirección -->
  <div class="relative">
    <label for="name" class="block text-sm font-medium text-slate-700">
      Nombre del edificio o dirección
    </label>
    <input
      id="name"
      name="name"
      type="text"
      autocomplete="off"
      maxlength="120"
      placeholder="Ej. Edificio Ana Pilar / Cra 56 #3-88"
      class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200"
    />
    <p id="name-error" class="mt-1 hidden text-xs font-medium text-red-600"></p>

    <ul
      id="suggestions"
      class="absolute z-[1200] mt-1 hidden max-h-56 w-full overflow-auto rounded-lg border border-slate-200 bg-white shadow-lg"
    >
    </ul>
  </div>

  <!-- Ubicación -->
  <div class="rounded-lg bg-slate-50 p-3">
    <div class="flex items-center justify-between gap-3">
      <p class="text-xs text-slate-600">
        Ubicación: <span id="location-status" class="font-semibold text-slate-800"
          >sin fijar</span
        >
      </p>
      <button
        type="button"
        id="pick-on-map"
        class="shrink-0 rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 transition hover:border-red-400 hover:text-red-600"
      >
        Ubicar en el mapa
      </button>
    </div>
    <p id="geo-note" class="mt-2 hidden text-xs text-amber-700"></p>
  </div>

  <!-- Recursos -->
  <div>
    <span class="block text-sm font-medium text-slate-700">
      Recursos necesarios
    </span>
    <div id="preset-chips" class="mt-2 space-y-2">
      {
        CATEGORIES.map((category, index) => (
          <details
            open={index === 0}
            data-category={category.id}
            class="overflow-hidden rounded-lg border border-slate-200"
          >
            <summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
              <span class="caret text-slate-400 transition-transform">▸</span>
              <span class="flex-1">{category.label}</span>
              <span data-count={category.id} class="text-xs text-slate-400">
                {category.items.length}
              </span>
            </summary>
            <div class="flex flex-wrap gap-2 px-3 pb-3">
              {category.items.map((item) => (
                <button
                  type="button"
                  data-preset={item}
                  data-category={category.id}
                  aria-pressed="false"
                  class={CHIP_OFF}
                >
                  {item}
                </button>
              ))}
            </div>
          </details>
        ))
      }
    </div>

    <input
      id="custom-resource"
      type="text"
      maxlength="60"
      placeholder="Otro recurso — escribe y presiona Enter"
      class="mt-3 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200"
    />

    <div id="selected-resources" class="mt-3 flex flex-wrap gap-2"></div>
    <p id="resources-error" class="mt-1 hidden text-xs font-medium text-red-600">
    </p>
  </div>

  <p class="text-xs text-slate-500">
    Lo que escribas es público: lo ve cualquiera que abra el mapa. No pongas nombres,
    teléfonos ni datos de las personas del edificio.
  </p>

  <button
    type="submit"
    class="w-full rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300"
  >
    Reportar edificio
  </button>
</form>

<style>
  /* Safari sigue pintando el triángulo nativo aunque `list-none` esté puesto. */
  summary::-webkit-details-marker {
    display: none;
  }

  details[open] > summary .caret {
    transform: rotate(90deg);
  }
</style>
