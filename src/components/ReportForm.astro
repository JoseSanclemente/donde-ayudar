---
import { CATEGORIES, CHIP_OFF } from "../scripts/resources";
---

<form
  id="report-form"
  novalidate
  class="space-y-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <h2 class="text-base font-semibold text-slate-900">Realizar reporte</h2>
      <p class="mt-1 text-sm text-slate-500">
        Indica el edificio afectado y qué recursos necesita.
      </p>
    </div>
    <button
      type="button"
      id="close-report"
      aria-label="Cerrar el formulario"
      class="-mr-1 -mt-1 shrink-0 rounded-md p-1.5 text-xl leading-none text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
    >
      ×
    </button>
  </div>

  <!-- Nombre / dirección -->
  <div class="relative">
    <label for="name" class="block text-sm font-medium text-slate-700">
      Nombre del edificio o dirección
    </label>
    <input
      id="name"
      name="name"
      type="text"
      autocomplete="off"
      maxlength="120"
      placeholder="Ej. Cra 56 #3-88"
      class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200"
    />
    <p id="name-error" class="mt-1 hidden text-xs font-medium text-red-600"></p>

    <ul
      id="suggestions"
      class="absolute z-[1200] mt-1 hidden max-h-56 w-full overflow-auto rounded-lg border border-slate-200 bg-white shadow-lg"
    >
    </ul>
  </div>

  <!-- Ubicación -->
  <div class="rounded-lg bg-slate-50 p-3">
    <div class="flex items-center justify-between gap-3">
      <p class="text-xs text-slate-600">
        Ubicación: <span id="location-status" class="font-semibold text-slate-800"
          >sin fijar</span
        >
      </p>
      <button
        type="button"
        id="pick-on-map"
        class="shrink-0 rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 transition hover:border-red-400 hover:text-red-600"
      >
        Ubicar en el mapa
      </button>
    </div>
    <!-- El consejo va antes de buscar, no después de que la búsqueda falle:
         OpenStreetMap no tiene la mayoría de los edificios residenciales de
         Cali, así que la dirección escrita casi siempre cae a media cuadra.
         Quien lo pone a mano acierta a la primera. -->
    <p class="mt-2 text-xs leading-snug text-slate-500">
      <span class="font-semibold text-slate-700">Lo más preciso es fijarlo tú:</span>
      toca «Ubicar en el mapa» y marca el edificio. Buscar por dirección suele dejar
      el punto en la cuadra, no en la puerta.
    </p>
    <p id="geo-note" class="mt-2 hidden text-xs text-amber-700"></p>
  </div>

  <!-- Recursos -->
  <div>
    <span class="block text-sm font-medium text-slate-700">
      Recursos necesarios
    </span>
    <div id="preset-chips" class="mt-2 space-y-2">
      {
        CATEGORIES.map((category, index) => (
          <details
            open={index === 0}
            data-category={category.id}
            class="overflow-hidden rounded-lg border border-slate-200"
          >
            <summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
              <span class="caret text-slate-400 transition-transform">▸</span>
              <span class="flex-1">{category.label}</span>
              <span data-count={category.id} class="text-xs text-slate-400">
                {category.items.length}
              </span>
            </summary>
            <div class="flex flex-wrap gap-2 px-3 pb-3">
              {category.items.map((item) => (
                <button
                  type="button"
                  data-preset={item}
                  data-category={category.id}
                  aria-pressed="false"
                  class={CHIP_OFF}
                >
                  {item}
                </button>
              ))}
            </div>
          </details>
        ))
      }
    </div>

    <div id="selected-resources" class="mt-3 flex flex-wrap gap-2"></div>
    <p id="resources-error" class="mt-1 hidden text-xs font-medium text-red-600">
    </p>
  </div>

  <div>
    <label for="note" class="block text-sm font-medium text-slate-700">
      Nota <span class="font-normal text-slate-400">(opcional)</span>
    </label>
    <p class="mt-0.5 text-xs text-slate-500">
      Lo que no cabe en los chips: herramientas específicas, qué ya no hace falta, cómo
      entrar.
    </p>
    <textarea
      id="note"
      rows="2"
      maxlength="200"
      placeholder="Ej: ya hay suficiente comida; faltan cascos y linternas para la noche."
      class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200"
    ></textarea>
    <p class="mt-1 text-right text-[11px] text-slate-400"><span id="note-count">0</span>/200</p>
  </div>

  <div>
    <label for="contact-name" class="block text-sm font-medium text-slate-700">
      Contacto en el punto <span class="font-normal text-slate-400">(opcional)</span>
    </label>
    <p class="mt-0.5 text-xs font-medium text-red-700">
      Se muestra públicamente en el mapa. Pon tu propio número, no el de otra persona.
    </p>
    <div class="mt-1.5 grid grid-cols-2 gap-2">
      <input
        id="contact-name"
        type="text"
        maxlength="60"
        autocomplete="off"
        placeholder="Nombre"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200"
      />
      <input
        id="contact-phone"
        type="tel"
        maxlength="20"
        autocomplete="off"
        placeholder="Teléfono"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200"
      />
    </div>
    <p id="contact-error" class="mt-1 hidden text-xs font-medium text-red-600"></p>
  </div>

  <label
    class="flex cursor-pointer items-start gap-2 rounded-lg border border-slate-200 bg-slate-50 p-3"
  >
    <input
      id="urgente"
      type="checkbox"
      class="mt-0.5 h-4 w-4 shrink-0 rounded border-slate-300 text-red-600 focus:ring-red-300"
    />
    <span class="text-xs text-slate-700">
      <span class="font-semibold text-slate-900">Es urgente</span> — hay gente atrapada o
      se necesita ayuda ya. Marca el punto en rojo intenso para todo el mundo; cualquiera
      puede cambiarlo después desde la lista.
    </span>
  </label>

  <p class="text-xs text-slate-500">
    Todo lo que escribas es público: lo ve cualquiera que abra el mapa. No pongas datos de
    las personas del edificio — el único contacto que va acá es el tuyo, y en su casilla.
  </p>

  <button
    type="submit"
    class="w-full rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300"
  >
    Reportar edificio
  </button>
</form>

<style>
  /* Safari sigue pintando el triángulo nativo aunque `list-none` esté puesto. */
  summary::-webkit-details-marker {
    display: none;
  }

  details[open] > summary .caret {
    transform: rotate(90deg);
  }
</style>
