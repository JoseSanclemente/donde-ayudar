---
/**
 * El catálogo de insumos, categoría por categoría. Lo comparten el reporte de
 * una necesidad y el registro de un punto de acopio: uno pregunta qué falta y el
 * otro qué reciben, pero los dos nombran la misma cosa — y por eso se pueden
 * comparar ítem por ítem.
 *
 * Los ids llevan prefijo porque los dos formularios viven a la vez en el DOM,
 * escondido uno detrás de la otra pestaña. `createResourcePicker(prefix)` en
 * `src/scripts/features/resource-picker.ts` es la mitad de este componente.
 */
import { CATEGORIES, CHIP_OFF } from "@/scripts/resources";

interface Props {
  prefix: string;
  label: string;

  hint?: string;
}

const { prefix, label, hint } = Astro.props;
---

<div>
  <span class="block text-sm font-medium text-slate-700">
    {label}
    {hint && <span class="font-normal text-slate-400">(opcional)</span>}
  </span>
  {hint && <p class="mt-0.5 text-xs text-slate-500">{hint}</p>}
  <div id={`${prefix}-preset-chips`} class="mt-2 space-y-2">
    {
      CATEGORIES.map((category) => (
        <details
          data-category={category.id}
          class="overflow-hidden rounded-lg border border-slate-200"
        >
          <summary
            class={`flex cursor-pointer list-none items-center gap-2 px-3 py-2 text-sm font-medium transition hover:brightness-95 ${category.chip}`}
          >
            <span class="caret opacity-60 transition-transform">▸</span>
            {/* Más grande que el texto y sin encogerse: el emoji es lo que se
                busca al recorrer la lista de un vistazo. */}
            <span class="shrink-0 text-lg leading-none">{category.emoji}</span>
            <span class="flex-1">{category.label}</span>
            {/* Sin color propio, como el contador: el encabezado ya va tintado
                con el de la categoría. Va dentro del `summary` para que se
                alcance sin desplegar — que es justo de lo que se trata. */}
            <button
              type="button"
              data-select-all={category.id}
              aria-pressed="false"
              class="rounded border border-current/30 px-1.5 py-0.5 text-xs font-medium opacity-70 transition hover:opacity-100"
            >
              Seleccionar todo
            </button>
            <span data-count={category.id} class="text-xs opacity-70">
              {category.items.length}
            </span>
          </summary>
          <div class="flex flex-wrap gap-2 px-3 py-3">
            {category.items.map((item) => (
              <button
                type="button"
                data-preset={item.trim()}
                data-category={category.id}
                aria-pressed="false"
                class={CHIP_OFF}
              >
                {item.trim()}
              </button>
            ))}
          </div>
        </details>
      ))
    }
  </div>

  <div id={`${prefix}-selected-resources`} class="mt-3 flex flex-wrap gap-2">
  </div>
  <p
    id={`${prefix}-resources-error`}
    class="mt-1 hidden text-xs font-medium text-red-600"
  >
  </p>
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  details[open] > summary .caret {
    transform: rotate(90deg);
  }

  /* Sin texto no hay error que mostrar. `clearError` ya pone la clase `hidden`,
     pero el hueco tampoco debe aparecer si alguna vez se vacía el párrafo sin
     pasar por ahí — el margen de un error invisible se ve igual. */
  p[id$="-resources-error"]:empty {
    display: none;
  }
</style>
