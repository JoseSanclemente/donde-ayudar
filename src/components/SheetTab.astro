---
// One pill of the mobile tab strip. The icon is drawn stroke-only and the
// selected tab is marked by filling it (`global.css`), which is why it is one
// `<path>` plus, at most, a direct-child `<circle>` for its hole: a second path
// would disappear into the silhouette.
import NewDot from "./NewDot.astro";

interface Props {
  /** The `data-tab-btn` value, matched against `#sheet`'s `data-tab`. */
  tab: string;
  label: string;
  icon: { path: string; circle?: { cx: number; cy: number; r: number } };
  /** Id of the «something new» dot, when the tab has one. */
  dot?: string;
}

const { tab, label, icon, dot } = Astro.props;
---

<button
  type="button"
  role="tab"
  data-tab-btn={tab}
  class="flex shrink-0 items-center justify-center gap-1 rounded-lg px-3 py-3 text-sm font-semibold transition"
>
  <svg
    viewBox="0 0 20 20"
    aria-hidden="true"
    class="h-4 w-4 shrink-0"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d={icon.path}></path>
    {icon.circle && <circle cx={icon.circle.cx} cy={icon.circle.cy} r={icon.circle.r} />}
  </svg>
  {label}
  {dot && <NewDot id={dot} hidden />}
</button>
