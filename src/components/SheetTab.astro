---
import NewDot from "./NewDot.astro";

interface Props {
  tab: string;
  label: string;
  icon: { path: string; circle?: { cx: number; cy: number; r: number } };

  dot?: string;
}

const { tab, label, icon, dot } = Astro.props;
---

<button
  type="button"
  role="tab"
  data-tab-btn={tab}
  class="flex shrink-0 items-center justify-center gap-1 rounded-lg px-3 py-3 text-sm font-semibold transition"
>
  <svg
    viewBox="0 0 20 20"
    aria-hidden="true"
    class="h-4 w-4 shrink-0"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d={icon.path}></path>
    {
      icon.circle && (
        <circle cx={icon.circle.cx} cy={icon.circle.cy} r={icon.circle.r} />
      )
    }
  </svg>
  {label}
  {dot && <NewDot id={dot} hidden />}
</button>
