---
// The markup face of the shared dot. Whoever lights it does it by id, through
// `setTabDot`: this component owns the look, never the state.
import { NEW_DOT } from "@/scripts/ui/dot";

interface Props {
  id?: string;
  /** Extra classes — how the dot sits in its row. */
  class?: string;
  hidden?: boolean;
  /** Screen-reader text. Without one the dot is decoration. */
  label?: string;
}

const { id, class: extra = "", hidden = false, label } = Astro.props;
---

<span
  id={id}
  hidden={hidden}
  aria-hidden={label ? undefined : "true"}
  class={`${NEW_DOT} ${extra}`.trim()}
>
  {label && <span class="sr-only">{label}</span>}
</span>
