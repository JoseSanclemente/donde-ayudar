---
// El reverso del reporte: el reporte dice qué falta en un punto, esto dice qué
// hay disponible en la ciudad y todavía no tiene adónde ir. Quien coordina en
// la calle lo despacha a un punto desde acá.
import { CATEGORIES, categoryTitle } from "../scripts/resources";
import { CARET } from "../scripts/ui/select";
import Select from "./Select.astro";
---

<section
  id="offers-panel-card"
  data-panel-card
  class="border-b border-slate-200 pb-5 pt-3"
>
  <div class="flex items-baseline justify-start gap-2">
    <h2 class="text-lg font-semibold text-slate-900">¿Tienes algo para donar?</h2>
    <span
      id="offers-count"
      class="rounded-full border border-slate-600 bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">0</span
    >

    <!-- Only on desktop: on mobile this is a whole tab of the sheet, and a tab
         that hides its own content would be a tab with nothing in it. -->
    <button
      type="button"
      id="offers-toggle"
      aria-expanded="false"
      aria-controls="offers-card-body"
      aria-label="Mostrar u ocultar la ayuda disponible"
      class="ml-auto hidden shrink-0 rounded-lg p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 lg:inline-flex"
    >
      <span id="offers-caret" aria-hidden="true">{CARET}</span>
    </button>
  </div>

  <div id="offers-card-body" data-card-body>
    <form id="offer-form" novalidate class="mt-3 flex flex-col gap-4">
      <input
        id="offer-title"
        type="text"
        maxlength="80"
        autocomplete="off"
        placeholder="Qué tienes. Ej: retroexcavadora con operario"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
      />

      <textarea
        id="offer-detail"
        rows="2"
        maxlength="200"
        placeholder="Detalles: hasta cuándo, cuánto cargas, desde dónde sale."
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
      ></textarea>

      <Select id="offer-category" label="Categoría de la ayuda">
        <option value="">Sin categoría</option>
        {CATEGORIES.map((category) => (
          <option value={category.id}>{categoryTitle(category.id)}</option>
        ))}
      </Select>

      <input
        id="offer-contact-name"
        type="text"
        maxlength="60"
        autocomplete="off"
        placeholder="Tu nombre"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
      />
      <input
        id="offer-contact-phone"
        type="tel"
        maxlength="20"
        autocomplete="off"
        placeholder="Teléfono"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
      />

      <div
        class="flex items-start gap-2 rounded-lg border border-blue-200 bg-blue-50 p-3 text-xs font-medium text-blue-700"
      >
        <svg
          viewBox="0 0 20 20"
          aria-hidden="true"
          class="mt-0.5 h-4 w-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="10" cy="10" r="7.5"></circle>
          <path d="M10 9.2v4.3"></path>
          <path d="M10 6.6v.1"></path>
        </svg>
        <p>
          El contacto es obligatorio y se muestra públicamente para que pueda coordinarse la ayuda.
        </p>
      </div>

      <p id="offer-error" class="hidden text-xs font-medium text-red-600"></p>

      <button
        type="submit"
        class="w-full rounded-lg bg-slate-900 px-3 py-4 text-sm font-semibold text-white transition hover:bg-red-600"
      >
        Publicar ayuda
      </button>
    </form>

    <h3 class="mt-6 text-lg font-semibold text-slate-900">Ayuda disponible</h3>

    <p id="offers-empty" class="mt-2 text-sm text-slate-500">
      Todavía nadie ha publicado ayuda disponible.
    </p>

    <ul id="offers-list" class="mt-3 space-y-3"></ul>

    <button
      type="button"
      id="offers-more"
      class="mt-3 hidden w-full rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-red-400 hover:text-red-600"
    >
      Ver más
    </button>
  </div>
</section>
