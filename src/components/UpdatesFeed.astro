---
// Bitácora de la ciudad. Lo que en el grupo de WhatsApp es un mensaje suelto
// («Chiminangos: ya no más alimentos, falta un baño portátil»), acá queda con
// hora y, si aplica, colgado de un punto del mapa.
import Select from "./Select.astro";
---

<!-- The separator border belongs to the sidebar stack: on desktop this section
     is the whole right column and has its own border, and a second line inside
     it would only cut the list short. -->
<section class="border-b border-slate-200 pb-5 pt-3 lg:border-0 lg:pb-0">
  <div class="flex items-baseline justify-start gap-2">
    <h2 class="text-lg font-semibold text-slate-900">¿Qué está pasando?</h2>
    <span
      id="updates-count"
      class="rounded-full border border-slate-600 bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">0</span
    >
  </div>

  <form id="update-form" novalidate class="mt-3 flex flex-col gap-4">
    <textarea
      id="update-body"
      rows="2"
      maxlength="280"
      placeholder="Ej: en la 44 con 9na ya hay suficientes manos; faltan cascos."
      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400"
    ></textarea>

    <div class="flex items-center gap-2">
      <Select
        id="update-report"
        label="Punto al que se refiere la novedad"
        class="min-w-0 flex-1"
      >
        <option value="">Novedad general</option>
      </Select>
    </div>

    <button
      type="submit"
      class="w-full rounded-lg bg-slate-900 px-3 py-4 text-sm font-semibold text-white transition hover:bg-red-600"
    >
      Publicar
    </button>

    <p id="update-error" class="hidden text-xs font-medium text-red-600"></p>
  </form>

  <h3 class="mt-6 text-lg font-semibold text-slate-900">Últimas novedades</h3>

  <p id="updates-empty" class="mt-2 text-sm text-slate-500">Todavía no hay novedades.</p>

  <ul id="updates-list" class="mt-3 space-y-7"></ul>

  <button
    type="button"
    id="updates-more"
    class="mt-3 hidden w-full rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-red-400 hover:text-red-600"
  >
    Ver más
  </button>
</section>
