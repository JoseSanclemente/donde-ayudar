---
// Whoever has the time and the will to help someone leaves their name here and
// how to write to them. The contact can be a WhatsApp or an Instagram, and one
// is enough: whoever offers to listen does not always hand out their number.
//
// The panel is the same for every kind of volunteer; the copy comes from
// `scripts/volunteers.ts`, and the id prefix is what keeps two of them on the
// same page from colliding.
import type { VolunteerPanel } from "../scripts/volunteers";
import { CARET } from "../scripts/ui/select";

interface Props {
  panel: VolunteerPanel;
}

const { panel } = Astro.props;
const { prefix } = panel;
const FIELD =
  "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400";
---

<section
  id={`${prefix}-panel-card`}
  data-panel-card
  class="border-b border-slate-200 pb-5 pt-3"
>
  <div class="flex items-baseline justify-start gap-2">
    <h2 class="text-lg font-semibold text-slate-900">{panel.title}</h2>
    <span
      id={`${prefix}-count`}
      class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">0</span
    >

    <!-- Only on desktop: on mobile this is a whole tab of the sheet, and a tab
         that hides its own content would be a tab with nothing in it. -->
    <button
      type="button"
      id={`${prefix}-toggle`}
      aria-expanded="false"
      aria-controls={`${prefix}-card-body`}
      aria-label={panel.toggleLabel}
      class="ml-auto hidden shrink-0 rounded-lg p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 lg:inline-flex"
    >
      <span id={`${prefix}-caret`} aria-hidden="true">{CARET}</span>
    </button>
  </div>

  <div id={`${prefix}-card-body`} data-card-body>
    <form id={`${prefix}-form`} novalidate class="mt-3 flex flex-col gap-4">
      <input
        id={`${prefix}-name`}
        type="text"
        maxlength="60"
        autocomplete="off"
        placeholder="Tu nombre"
        class={FIELD}
      />

      <input
        id={`${prefix}-phone`}
        type="tel"
        maxlength="20"
        autocomplete="off"
        placeholder="WhatsApp"
        class={FIELD}
      />

      <input
        id={`${prefix}-instagram`}
        type="text"
        maxlength="31"
        autocomplete="off"
        placeholder="Usuario de Instagram (opcional)"
        class={FIELD}
      />

      <textarea
        id={`${prefix}-notes`}
        rows="2"
        maxlength="200"
        placeholder={panel.notesPlaceholder}
        class={FIELD}></textarea>

      <div
        class="flex items-start gap-2 rounded-lg border border-blue-200 bg-blue-50 p-3 text-xs font-medium text-blue-700"
      >
        <svg
          viewBox="0 0 20 20"
          aria-hidden="true"
          class="mt-0.5 h-4 w-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="10" cy="10" r="7.5"></circle>
          <path d="M10 9.2v4.3"></path>
          <path d="M10 6.6v.1"></path>
        </svg>
        <p>
          Tu contacto se muestra públicamente para que quien lo necesite pueda escribirte.
        </p>
      </div>

      <p id={`${prefix}-error`} class="hidden text-xs font-medium text-red-600"></p>

      <button
        type="submit"
        class="w-full rounded-lg bg-slate-900 px-3 py-4 text-sm font-semibold text-white transition hover:bg-red-600"
      >
        Inscribirse
      </button>
    </form>

    <h3 class="mt-6 text-lg font-semibold text-slate-900">{panel.listTitle}</h3>

    <p id={`${prefix}-empty`} class="mt-2 text-sm text-slate-500">
      {panel.emptyLabel}
    </p>

    <ul id={`${prefix}-list`} class="mt-3 space-y-3"></ul>

    <button
      type="button"
      id={`${prefix}-more`}
      class="mt-3 hidden w-full rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-red-400 hover:text-red-600"
    >
      Ver más
    </button>
  </div>
</section>
