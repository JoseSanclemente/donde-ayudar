---
import {
  DEFAULT_VOLUNTEER_KIND,
  VOLUNTEER_KIND_CHIPS,
  VOLUNTEER_KIND_IDS,
  VOLUNTEER_KINDS,
} from "@/scripts/volunteers";
import { CHIP_BASE, CHIP_OFF } from "@/scripts/ui/chip-group";
import { CARET } from "@/scripts/ui/select";
import Select from "./Select.astro";

const FIELD =
  "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-slate-400";
---

<section
  id="volunteer-panel-card"
  data-panel-card
  class="border-b border-slate-200 pb-5 pt-3"
>
  <div class="flex items-baseline justify-start gap-2">
    <h2 class="text-lg font-semibold text-slate-900">¿En qué puedes ayudar?</h2>
    <span
      id="volunteer-count"
      class="rounded-full border border-slate-600 bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600"
      >0</span
    >

    <!-- Only on desktop: on mobile this is a whole tab of the sheet, and a tab
         that hides its own content would be a tab with nothing in it. -->
    <button
      type="button"
      id="volunteer-toggle"
      aria-expanded="false"
      aria-controls="volunteer-card-body"
      aria-label="Mostrar u ocultar las inscripciones"
      class="ml-auto hidden shrink-0 rounded-lg p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 lg:inline-flex"
    >
      <span id="volunteer-caret" aria-hidden="true">{CARET}</span>
    </button>
  </div>

  <div id="volunteer-card-body" data-card-body>
    <form id="volunteer-form" novalidate class="mt-3 flex flex-col gap-4">
      <!-- No empty option: unlike the category of a donation, the trade is
           mandatory, so the form opens on one instead of asking twice. -->
      <Select id="volunteer-kind" label="En qué puedes ayudar">
        {
          VOLUNTEER_KIND_IDS.map((kind) => (
            <option value={kind} selected={kind === DEFAULT_VOLUNTEER_KIND}>
              {VOLUNTEER_KINDS[kind].label}
            </option>
          ))
        }
      </Select>

      <input
        id="volunteer-name"
        type="text"
        maxlength="60"
        autocomplete="off"
        placeholder="Tu nombre"
        class={FIELD}
      />

      <input
        id="volunteer-phone"
        type="tel"
        maxlength="20"
        autocomplete="off"
        placeholder="WhatsApp"
        class={FIELD}
      />

      <input
        id="volunteer-instagram"
        type="text"
        maxlength="31"
        autocomplete="off"
        placeholder="Usuario de Instagram (opcional)"
        class={FIELD}
      />

      <textarea
        id="volunteer-notes"
        rows="2"
        maxlength="200"
        placeholder={VOLUNTEER_KINDS[DEFAULT_VOLUNTEER_KIND].notesPlaceholder}
        class={FIELD}></textarea>

      <div
        class="flex items-start gap-2 rounded-lg border border-blue-200 bg-blue-50 p-3 text-xs font-medium text-blue-700"
      >
        <svg
          viewBox="0 0 20 20"
          aria-hidden="true"
          class="mt-0.5 h-4 w-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="10" cy="10" r="7.5"></circle>
          <path d="M10 9.2v4.3"></path>
          <path d="M10 6.6v.1"></path>
        </svg>
        <p>
          Tu contacto se muestra públicamente para que quien lo necesite pueda
          escribirte.
        </p>
      </div>

      <p id="volunteer-error" class="hidden text-xs font-medium text-red-600">
      </p>

      <button
        type="submit"
        class="w-full rounded-lg bg-slate-900 px-3 py-4 text-sm font-semibold text-white transition hover:bg-red-600"
      >
        Inscribirse
      </button>
    </form>

    <h3 class="mt-6 text-lg font-semibold text-slate-900">
      Personas inscritas
    </h3>

    <!-- Los chips salen apagados: una fila sin nada marcado no pide nada, y
         tocar «Jurídica» deja las abogadas en vez de quitarlas. Marcado toma el
         color que tiene en la tarjeta, así que la fila es también la leyenda de
         la lista. El estado vive en `aria-pressed`. -->
    <div id="volunteer-filter" class="mt-3 flex flex-wrap gap-2">
      {
        VOLUNTEER_KIND_CHIPS.map((chip) => (
          <button
            type="button"
            data-volunteer-kind-filter={chip.id}
            aria-pressed="false"
            class={`${CHIP_BASE} ${CHIP_OFF}`}
          >
            {chip.label}
          </button>
        ))
      }
    </div>

    <p id="volunteer-empty" class="mt-3 text-sm text-slate-500">
      Todavía nadie se ha inscrito.
    </p>

    <ul id="volunteer-list" class="mt-3 space-y-3"></ul>

    <button
      type="button"
      id="volunteer-more"
      class="mt-3 hidden w-full rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-red-400 hover:text-red-600"
    >
      Ver más
    </button>
  </div>
</section>
