---
import "@/styles/global.css";
import { OG_IMAGE, OG_IMAGE_ALT, SITE_DESCRIPTION, SITE_NAME } from "@/consts";

interface Props {
  title: string;
  description?: string;
  scroll?: boolean;
}

const { title, description = SITE_DESCRIPTION, scroll = false } = Astro.props;

const bodyClass = scroll
  ? "min-h-screen"
  : "min-h-screen overflow-hidden overscroll-none lg:overflow-auto lg:overscroll-auto";

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(OG_IMAGE, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://a.basemaps.cartocdn.com" crossorigin />
    <link
      rel="preconnect"
      href="https://fqyuuvinpmwwakqfkebt.supabase.co"
      crossorigin
    />

    <title>{title}</title>

    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta property="og:locale" content="es_CO" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    <meta name="theme-color" content="#ef4444" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
