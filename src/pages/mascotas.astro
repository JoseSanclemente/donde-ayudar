---
import Base from "../layouts/Base.astro";
import PetsFilters from "../components/PetsFilters.astro";
import { PETS_DESCRIPTION, PETS_NAME, PETS_TITLE } from "../consts";
---

<Base title={PETS_TITLE} description={PETS_DESCRIPTION} scroll>
  <div class="mx-auto max-w-5xl px-4 pb-16 lg:max-w-7xl">
    <!-- El encabezado del mapa es fijo porque flota encima de él; acá se pega
         arriba: la cuadrícula es larga y el único camino de vuelta al mapa
         estaba a un scroll de distancia. Va opaco y en el gris del `body` —no
         blanco, que dejaría una franja donde no la hay, y sin desenfoque, que
         en un celular se paga en cada frame del desplazamiento. -->
    <header
      id="site-header"
      class="sticky top-0 z-30 -mx-4 border-b border-slate-200/60 bg-slate-50 px-4 py-4"
    >
      <a
        href="/"
        class="inline-flex items-center gap-1 text-sm font-medium text-slate-500 transition hover:text-red-600"
      >
        <span aria-hidden="true">←</span>
        Volver al mapa
      </a>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">
        {PETS_NAME}
      </h1>
    </header>

    <div class="pt-5 lg:flex lg:items-start lg:gap-6">
      <!-- En escritorio el filtro no es un botón flotante sino una columna, como
           la barra lateral del mapa: hay ancho de sobra y esconder los chips
           detrás de un embudo solo cobraría un clic. En móvil el `hidden` la
           borra entera —el panel de abajo es el que muestra la tarjeta— y por
           eso el marco blanco vive acá y no en la tarjeta, que se muda. -->
      <aside
        id="pets-filters-column"
        class="hidden lg:sticky lg:top-[6.5rem] lg:block lg:w-[17rem] lg:shrink-0 lg:rounded-2xl lg:border lg:border-slate-200 lg:bg-white lg:px-4 lg:pb-3 lg:shadow-sm"
      >
        <div id="pets-filters-card"><PetsFilters /></div>
      </aside>

    <section class="flex min-h-svh flex-col lg:min-w-0 lg:flex-1">
      <div class="flex items-baseline justify-start gap-2">
        <h2 class="text-lg font-semibold text-slate-900">Encontradas</h2>
        <span
          id="pets-count"
          class="rounded-full border border-slate-600 bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600"
          >0</span
        >
      </div>

      <div
        id="pets-state"
        class="flex flex-1 flex-col items-center justify-center gap-3"
      >
        <span
          id="pets-spinner"
          aria-hidden="true"
          class="h-8 w-8 animate-spin rounded-full border-2 border-slate-200 border-t-red-600"
        ></span>
        <p id="pets-empty" class="text-center text-sm text-slate-500">
          Cargando mascotas…
        </p>
      </div>

      <ul id="pets-grid" class="mt-3 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4">
      </ul>
    </section>
    </div>

    <footer class="mt-8 border-t border-slate-200/60 pt-4 text-xs text-slate-400">
      <a href="/privacidad" class="transition hover:text-slate-600">Privacidad</a>
    </footer>
  </div>

  <!-- Con la cuadrícula entera cuesta encontrar un perro entre los gatos: acá se
       decide qué tarjetas quedan. Solo en móvil —en escritorio los chips están
       a la vista en su columna y este botón abriría lo que ya se ve. No lleva la
       clase `fab-filter` del mapa —esa se apila con selectores `~` contra
       botones que esta página no tiene— y va por debajo del scrim, así que
       mientras el panel está arriba lo tapa. -->
  <button
    type="button"
    id="pets-fab-filter"
    aria-label="Filtrar las mascotas"
    aria-controls="pets-filters-card"
    class="fixed bottom-[calc(1.5rem+env(safe-area-inset-bottom))] right-4 z-[980] inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-4 text-slate-700 shadow-lg transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 lg:hidden"
  >
    <svg
      viewBox="0 0 20 20"
      aria-hidden="true"
      class="h-4 w-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M3 5h14l-5.5 6.2V16l-3 1.5v-6.3L3 5z"></path>
    </svg>
  </button>

  <!-- El mismo panel de abajo del mapa, sin sus pestañas: acá solo hay una cosa
       que mostrar. A diferencia de aquel no se disuelve en escritorio —esta
       página no tiene barra lateral donde poner la ficha—, solo se angosta. -->
  <div
    id="pet-sheet-scrim"
    hidden
    class="fixed inset-0 z-[990] bg-slate-900/40 opacity-0"
  >
  </div>

  <div
    id="pet-sheet"
    data-state="closed"
    class="fixed inset-x-0 bottom-0 z-[1000] flex max-h-[86svh] flex-col rounded-t-2xl border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_30px_rgba(0,0,0,0.12)] lg:inset-x-auto lg:left-1/2 lg:-ml-[13rem] lg:w-[26rem]"
  >
    <div id="pet-sheet-grab" class="shrink-0 select-none px-4 pb-4 pt-2.5">
      <span class="mx-auto block h-1.5 w-10 rounded-full bg-slate-300"></span>
      <div class="mt-1.5 flex justify-end">
        <button
          type="button"
          id="pet-sheet-close"
          aria-label="Cerrar la ficha"
          class="rounded-lg p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
        >
          <svg
            viewBox="0 0 20 20"
            aria-hidden="true"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M5 5l10 10M15 5L5 15"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="pet-sheet-body"
      class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain px-4 pb-4"
    >
    </div>
  </div>
</Base>

<script>
  import "../scripts/pets";
</script>
