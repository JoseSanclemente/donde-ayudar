---
import Base from "@/layouts/Base.astro";
import PetsFilters from "@/components/PetsFilters.astro";
import { PETS_DESCRIPTION, PETS_NAME, PETS_TITLE } from "@/consts";
---

<Base title={PETS_TITLE} description={PETS_DESCRIPTION} scroll>
  <div class="mx-auto max-w-5xl px-4 pb-16 lg:max-w-7xl">
    <header
      id="site-header"
      class="sticky top-0 z-30 -mx-4 border-b border-slate-200/60 bg-slate-50 px-4 py-4"
    >
      <a
        href="/"
        class="inline-flex items-center gap-1 text-sm font-medium text-slate-500 transition hover:text-red-600"
      >
        <span aria-hidden="true">←</span>
        Volver al mapa
      </a>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">
        {PETS_NAME}
      </h1>
    </header>

    <div class="pt-5 lg:flex lg:items-start lg:gap-6">
      <aside
        id="pets-filters-column"
        class="hidden lg:sticky lg:top-26 lg:block lg:w-68 lg:shrink-0 lg:rounded-2xl lg:border lg:border-slate-200 lg:bg-white lg:px-4 lg:pb-3 lg:shadow-sm"
      >
        <div id="pets-filters-card"><PetsFilters /></div>
      </aside>

      <section class="flex min-h-svh flex-col lg:min-w-0 lg:flex-1">
        <div class="flex items-baseline justify-start gap-2">
          <h2 class="text-lg font-semibold text-slate-900">Encontradas</h2>
          <span
            id="pets-count"
            class="rounded-full border border-slate-600 bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600"
            >0</span
          >
        </div>

        <div
          id="pets-state"
          class="flex flex-1 flex-col items-center justify-center gap-3"
        >
          <span
            id="pets-spinner"
            aria-hidden="true"
            class="h-8 w-8 animate-spin rounded-full border-2 border-slate-200 border-t-red-600"
          ></span>
          <p id="pets-empty" class="text-center text-sm text-slate-500">
            Cargando mascotas…
          </p>
        </div>

        <ul
          id="pets-grid"
          class="mt-3 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-2 xl:grid-cols-3"
        >
        </ul>

        <div id="pets-more" aria-hidden="true" class="h-px w-full"></div>
      </section>
    </div>

    <footer
      class="mt-8 border-t border-slate-200/60 pt-4 text-xs text-slate-400"
    >
      <a href="/privacidad" class="transition hover:text-slate-600"
        >Privacidad</a
      >
    </footer>
  </div>

  <button
    type="button"
    id="pets-fab-filter"
    aria-label="Filtrar las mascotas"
    aria-controls="pets-filters-card"
    class="fixed bottom-[calc(1.5rem+env(safe-area-inset-bottom))] right-4 z-980 inline-flex items-center justify-center rounded-full border border-red-200 bg-red-50 p-5 text-red-600 shadow-lg transition-colors focus:outline-none focus:ring-2 focus:ring-red-300 lg:hidden"
  >
    <svg
      viewBox="0 0 20 20"
      aria-hidden="true"
      class="h-6 w-6"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M3 5h14l-5.5 6.2V16l-3 1.5v-6.3L3 5z"></path>
    </svg>
  </button>

  <div
    id="pet-sheet-scrim"
    hidden
    class="fixed inset-0 z-990 bg-slate-900/40 opacity-0"
  >
  </div>

  <div
    id="pet-sheet"
    data-state="closed"
    class="fixed inset-x-0 bottom-0 z-1000 flex max-h-[86svh] flex-col rounded-t-2xl border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_30px_rgba(0,0,0,0.12)] lg:inset-x-auto lg:left-1/2 lg:-ml-52 lg:w-104"
  >
    <div id="pet-sheet-grab" class="shrink-0 select-none px-4 pb-4 pt-2.5">
      <span class="mx-auto block h-1.5 w-10 rounded-full bg-slate-300"></span>
      <div class="mt-1.5 flex justify-end">
        <button
          type="button"
          id="pet-sheet-close"
          aria-label="Cerrar la ficha"
          class="rounded-lg p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
        >
          <svg
            viewBox="0 0 20 20"
            aria-hidden="true"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M5 5l10 10M15 5L5 15"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="pet-sheet-body"
      class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain px-4 pb-4"
    >
    </div>
  </div>
</Base>

<script>
  import "../scripts/pets";
</script>
