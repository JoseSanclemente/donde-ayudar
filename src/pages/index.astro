---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import AlertBanner from "../components/AlertBanner.astro";
import CentroFilter from "../components/CentroFilter.astro";
import ReportForm from "../components/ReportForm.astro";
import ReportList from "../components/ReportList.astro";
import OffersPanel from "../components/OffersPanel.astro";
import UpdatesFeed from "../components/UpdatesFeed.astro";
import { SITE_NAME, SITE_TITLE } from "../consts";

// Los centros de acopio son datos de build (ver src/content/centros/README.md):
// se resuelven acá y viajan al cliente embebidos en el HTML, no por fetch.
const centros = (await getCollection("centros", ({ data }) => data.activo)).map(
  ({ id, data }) => ({ id, ...data }),
);
// Un conteo por tipo, cada uno con su filtro: restar del total metía los
// albergues en la cuenta de bancos de sangre.
const acopio = centros.filter((centro) => centro.tipo === "acopio").length;
const sangre = centros.filter((centro) => centro.tipo === "sangre").length;
const albergues = centros.filter((centro) => centro.tipo === "albergue").length;
// Un punto en pausa sigue contando en su tipo: está abierto, solo que hoy no
// recibe. El conteo aparte evita que el estado solo se descubra al abrir un pin.
const pausados = centros.filter(
  (centro) => centro.tipo !== "sangre" && !centro.recibiendo,
).length;
---

<Base title={SITE_TITLE}>
  <div class="mx-auto max-w-[1600px] lg:flex lg:h-screen lg:overflow-hidden">
    <!-- Panel lateral (en móvil: header flotante + bottom sheet) -->
    <div
      class="lg:flex lg:h-screen lg:w-[26rem] lg:shrink-0 lg:flex-col lg:gap-5 lg:overflow-y-auto lg:p-5"
    >
      <header
        id="site-header"
        class="fixed inset-x-0 top-0 z-[900] border-b border-slate-200/60 bg-white/80 px-4 pb-3 pt-[max(0.75rem,env(safe-area-inset-top))] backdrop-blur lg:static lg:z-auto lg:border-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none"
      >
        <p
          class="inline-flex items-center gap-2 rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700"
        >
          <span class="pulse-marker inline-block"
            ><span class="pulse-ring"></span><span class="pulse-dot"></span></span
          >
          Emergencia sismo — Cali
        </p>
        <h1 class="mt-2 text-lg font-bold tracking-tight text-slate-900 lg:mt-3 lg:text-2xl">
          {SITE_NAME}
        </h1>
        <p class="mt-1 hidden text-sm text-slate-600 lg:block">
          Mapa colaborativo de edificios afectados y los recursos que necesitan.
        </p>

        <AlertBanner />
      </header>

      <!-- Cerrado, el sheet sale entero de la pantalla: mientras está abierto el
           scrim atenúa el mapa y lo cierra al tocarlo. -->
      <div
        id="sheet-scrim"
        hidden
        class="fixed inset-0 z-[990] bg-slate-900/40 opacity-0 lg:hidden"
      >
      </div>

      <div
        id="sheet"
        data-state="closed"
        data-tab="puntos"
        class="fixed inset-x-0 bottom-0 z-[1000] flex max-h-[86svh] flex-col rounded-t-2xl border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_30px_rgba(0,0,0,0.12)] lg:contents"
      >
        <div id="sheet-grab" class="shrink-0 select-none px-4 pb-2 pt-2.5 lg:hidden">
          <span class="mx-auto block h-1.5 w-10 rounded-full bg-slate-300"></span>
          <div class="mt-2.5 flex items-center gap-1.5">
            <div class="flex min-w-0 flex-1 gap-1.5" role="tablist">
              <button
                type="button"
                role="tab"
                data-tab-btn="puntos"
                class="flex-1 rounded-lg px-2 py-1.5 text-xs font-semibold transition"
              >
                Puntos
              </button>
              <button
                type="button"
                role="tab"
                data-tab-btn="novedades"
                class="flex-1 rounded-lg px-2 py-1.5 text-xs font-semibold transition"
              >
                Novedades
              </button>
              <button
                type="button"
                role="tab"
                data-tab-btn="ayuda"
                class="flex-1 rounded-lg px-2 py-1.5 text-xs font-semibold transition"
              >
                Ayuda
              </button>
            </div>
            <button
              type="button"
              id="sheet-close"
              aria-label="Cerrar el panel"
              class="shrink-0 rounded-lg p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
            >
              <svg
                viewBox="0 0 20 20"
                aria-hidden="true"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <path d="M5 5l10 10M15 5L5 15"></path>
              </svg>
            </button>
          </div>
        </div>

        <div
          id="sheet-body"
          class="flex min-h-0 flex-1 flex-col gap-5 overflow-y-auto overscroll-contain px-4 pb-4 lg:contents"
        >
          <div id="form-card" data-tab-panel="reportar"><ReportForm /></div>

          <!-- Detalle de un punto del mapa. Como el formulario, es una pestaña
               sin botón en el encabezado: solo se llega tocando un marcador, y
               el «Volver» es la única salida hacia la lista. En escritorio no
               existe — allá el detalle sigue siendo el popup de Leaflet. -->
          <div id="detail-card" data-tab-panel="detalle">
            <button
              type="button"
              id="detail-back"
              class="mb-3 inline-flex items-center gap-1 rounded-lg px-2 py-1.5 text-xs font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
            >
              <span aria-hidden="true">‹</span>
              Volver a puntos
            </button>
            <div id="detail-body" class="space-y-2"></div>
          </div>

          <!-- «Puntos» es un panel con dos tarjetas: la lista de edificios y
               dónde donar. En escritorio el sheet es `display: contents`, así
               que el `contents` de acá deja que las dos tarjetas se apilen
               igual que antes en la barra lateral. -->
          <div id="list-card" data-tab-panel="puntos" class="space-y-5 lg:contents">
            <ReportList />
            <CentroFilter
              acopio={acopio}
              sangre={sangre}
              albergues={albergues}
              pausados={pausados}
            />
          </div>

          <div data-tab-panel="novedades"><UpdatesFeed /></div>

          <div id="offers-card" data-tab-panel="ayuda"><OffersPanel /></div>

          <p class="pb-2 text-xs text-slate-400">
            Los reportes son públicos: los ve todo el mundo y solo quien los creó puede
            borrarlos. Los centros de acopio, los bancos de sangre y los albergues son
            una lista verificada por el equipo. Datos de mapa &copy;
            colaboradores de OpenStreetMap, teselas &copy; CARTO.
          </p>
        </div>
      </div>
    </div>

    <!-- Mapa -->
    <main class="fixed inset-0 z-0 lg:static lg:h-screen lg:flex-1 lg:p-5">
      <div
        id="map"
        class="h-full w-full lg:overflow-hidden lg:rounded-2xl lg:border lg:border-slate-200 lg:shadow-sm"
      >
      </div>
    </main>

    <!-- Único acceso al formulario: el reporte es la excepción, no lo primero
         que se ve. Va fuera del mapa y del sheet para que el `fixed` valga
         igual en móvil y en escritorio. -->
    <button
      type="button"
      id="fab-report"
      class="fab-report fixed right-4 z-[1050] inline-flex items-center gap-2 rounded-full bg-red-600 px-4 py-3 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300 lg:right-8"
    >
      <span aria-hidden="true" class="text-base leading-none">+</span>
      Realizar reporte
    </button>

    <!-- Con el sheet cerrado del todo, este es el único modo de volver a abrirlo
         en móvil. En escritorio no existe: allá el panel es la barra lateral. -->
    <button
      type="button"
      id="sheet-toggle"
      hidden
      aria-label="Abrir el panel de puntos y novedades"
      aria-controls="sheet"
      class="sheet-toggle fixed right-4 z-[1050] inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-lg transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 lg:hidden"
    >
      <svg
        viewBox="0 0 20 20"
        aria-hidden="true"
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M3 5h14M3 10h14M3 15h14"></path>
      </svg>
      Ver panel
    </button>
  </div>
</Base>

<script
  is:inline
  type="application/json"
  id="centros-data"
  set:html={JSON.stringify(centros).replace(/</g, "\\u003c")}
/>

<script>
  import "../scripts/app";
</script>
