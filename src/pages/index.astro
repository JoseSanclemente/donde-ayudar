---
import Base from "../layouts/Base.astro";
import AlertBanner from "../components/AlertBanner.astro";
import PickHint from "../components/PickHint.astro";
import ReportTabs from "../components/ReportTabs.astro";
import ReportList from "../components/ReportList.astro";
import MapFilters from "../components/MapFilters.astro";
import OffersPanel from "../components/OffersPanel.astro";
import MentalHealthPanel from "../components/MentalHealthPanel.astro";
import UpdatesFeed from "../components/UpdatesFeed.astro";
import NewDot from "../components/NewDot.astro";
import { SITE_NAME, SITE_TITLE } from "../consts";
---

<Base title={SITE_TITLE}>
  <div class="mx-auto max-w-[1920px] lg:relative lg:flex lg:h-screen lg:overflow-hidden">
    <!-- Panel lateral (en móvil: header flotante + bottom sheet) -->
    <div
      class="lg:flex lg:h-screen lg:w-[26rem] lg:shrink-0 lg:flex-col lg:gap-5 lg:overflow-y-auto lg:p-5"
    >
      <!-- Sin `backdrop-blur`: en móvil este header está fijo encima del mapa,
           así que cada frame de un arrastre obliga a desenfocar de nuevo la
           franja entera. El blanco casi opaco separa igual del mapa y el
           desenfoque solo existía en móvil, que es donde más caro sale. -->
      <header
        id="site-header"
        class="fixed inset-x-0 top-0 z-[900] border-b border-slate-200/60 bg-white/95 px-4 pb-3 pt-[max(0.75rem,env(safe-area-inset-top))] lg:static lg:z-auto lg:border-0 lg:bg-transparent lg:p-0"
      >
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 lg:mt-3 lg:text-2xl">
          {SITE_NAME}
        </h1>
        <span
          id="sync-badge"
          class="mt-1.5 inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600"
        >
          <span id="sync-dot" class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          <span id="sync-label">Cargando…</span>
        </span>
        <p class="mt-1 hidden text-sm text-slate-600 lg:block">
          Mapa colaborativo de edificios afectados y los recursos que necesitan.
        </p>

        <AlertBanner />
        <PickHint />
      </header>

      <!-- Cerrado, el sheet sale entero de la pantalla: mientras está abierto el
           scrim atenúa el mapa y lo cierra al tocarlo. -->
      <div
        id="sheet-scrim"
        hidden
        class="fixed inset-0 z-[990] bg-slate-900/40 opacity-0 lg:hidden"
      >
      </div>

      <div
        id="sheet"
        data-state="closed"
        data-tab="puntos"
        class="fixed inset-x-0 bottom-0 z-[1000] flex max-h-[86svh] flex-col rounded-t-2xl border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_30px_rgba(0,0,0,0.12)] lg:contents"
      >
        <div id="sheet-grab" class="shrink-0 select-none px-4 pb-4 pt-2.5 lg:hidden">
          <span class="mx-auto block h-1.5 w-10 rounded-full bg-slate-300"></span>
          <!-- Its own row between the pill and the tabs, so the three tabs keep
               the full width. -->
          <div class="mt-1.5 flex justify-end">
            <button
              type="button"
              id="sheet-close"
              aria-label="Cerrar el panel"
              class="rounded-lg p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
            >
              <svg
                viewBox="0 0 20 20"
                aria-hidden="true"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <path d="M5 5l10 10M15 5L5 15"></path>
              </svg>
            </button>
          </div>
          <div id="sheet-tabs" class="mt-2.5 flex items-center gap-1.5">
            <div
              class="sheet-tabs-scroll flex min-w-0 flex-1 gap-1.5 overflow-x-auto"
              role="tablist"
            >
              <button
                type="button"
                role="tab"
                data-tab-btn="puntos"
                class="flex shrink-0 items-center justify-center gap-1 rounded-lg px-3 py-3 text-sm font-semibold transition"
              >
                <svg
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                  class="h-4 w-4 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M10 17.5c3.4-3.6 5.1-6.3 5.1-8.3a5.1 5.1 0 10-10.2 0c0 2 1.7 4.7 5.1 8.3z"
                  ></path>
                  <circle cx="10" cy="9" r="1.8"></circle>
                </svg>
                Puntos
              </button>
              <button
                type="button"
                role="tab"
                data-tab-btn="novedades"
                class="flex shrink-0 items-center justify-center gap-1 rounded-lg px-3 py-3 text-sm font-semibold transition"
              >
                <svg
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                  class="h-4 w-4 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M10 3.2A4.3 4.3 0 005.7 7.5c0 3.6-1.4 4.8-1.4 4.8h11.4s-1.4-1.2-1.4-4.8A4.3 4.3 0 0010 3.2z"
                  ></path>
                  <path d="M8.6 15a1.6 1.6 0 002.8 0"></path>
                </svg>
                Novedades
                <NewDot id="novedades-dot" hidden />
              </button>
              <button
                type="button"
                role="tab"
                data-tab-btn="ayuda"
                class="flex shrink-0 items-center justify-center gap-1 rounded-lg px-3 py-3 text-sm font-semibold transition"
              >
                <svg
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                  class="h-4 w-4 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M10 16.6c-4.3-2.8-6.4-5.3-6.4-7.7A3.3 3.3 0 0110 6.3a3.3 3.3 0 016.4 2.6c0 2.4-2.1 4.9-6.4 7.7z"
                  ></path>
                </svg>
                Voluntarios
                <NewDot id="ayuda-dot" hidden />
              </button>
              <button
                type="button"
                role="tab"
                data-tab-btn="salud"
                class="flex shrink-0 items-center justify-center gap-1 rounded-lg px-3 py-3 text-sm font-semibold transition"
              >
                <!-- One closed outer path plus a direct-child `circle`: the
                     selected-tab rules in `global.css` fill everything that is
                     not a `circle`, so an inner path would disappear into the
                     silhouette. -->
                <svg
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                  class="h-4 w-4 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12.2 17.4v-2.6h1.9c.6 0 1-.5.9-1.1l-.4-2.3c1-2.6-.2-5.5-2.8-6.7C9.1 3.4 6 4.5 4.7 7.1a5.6 5.6 0 001.4 6.8v3.5h6.1z"
                  ></path>
                  <circle cx="9" cy="9.6" r="1.9"></circle>
                </svg>
                Salud mental
              </button>
            </div>
          </div>
        </div>

        <div
          id="sheet-body"
          class="flex min-h-0 flex-1 flex-col gap-5 overflow-y-auto overscroll-contain px-4 pb-4 lg:contents"
        >
          <div id="form-card" data-tab-panel="reportar"><ReportTabs /></div>

          <!-- Detalle de un punto del mapa. Como el formulario, es una pestaña
               sin botón en el encabezado: solo se llega tocando un marcador, y
               la ✕ del encabezado del sheet es la única salida. En escritorio no
               existe — allá el detalle sigue siendo el popup de Leaflet. -->
          <div id="detail-card" data-tab-panel="detalle">
            <div id="detail-body" class="space-y-2"></div>
          </div>

          <!-- Como el detalle: una pestaña sin botón en el encabezado, a la que
               solo se llega por el botón flotante del embudo. En escritorio el
               stylesheet la saca del sheet y la vuelve un popover sobre ese
               mismo botón, igual que con `#updates-card`. -->
          <div id="filters-card" data-tab-panel="filtros"><MapFilters /></div>

          <!-- «Puntos» es la lista de edificios. En escritorio el sheet es
               `display: contents`, y el `contents` de acá deja que la tarjeta
               caiga igual que antes en la barra lateral. -->
          <div id="list-card" data-tab-panel="puntos" class="space-y-5 lg:contents">
            <ReportList />
          </div>

          <!-- On desktop this card does not stay in the sidebar: the stylesheet
               lifts it out to be the third column, to the right of the map. It
               stays here in the markup because on mobile it is one more tab of
               the sheet. -->
          <div id="updates-card" data-tab-panel="novedades"><UpdatesFeed /></div>

          <div id="offers-card" data-tab-panel="ayuda"><OffersPanel /></div>

          <div id="mental-card" data-tab-panel="salud"><MentalHealthPanel /></div>
        </div>
      </div>
    </div>

    <!-- Mapa -->
    <main class="fixed inset-0 z-0 lg:static lg:h-screen lg:flex-1 lg:p-5 lg:pr-[var(--right-column)]">
      <div
        id="map"
        class="h-full w-full lg:overflow-hidden lg:rounded-2xl lg:border lg:border-slate-200 lg:shadow-sm"
      >
      </div>
    </main>

    <!-- Único acceso al formulario: el reporte es la excepción, no lo primero
         que se ve. Va fuera del mapa y del sheet para que el `fixed` valga
         igual en móvil y en escritorio. -->
    <button
      type="button"
      id="fab-report"
      class="fab-report fixed right-4 z-1050 inline-flex items-center gap-2 rounded-full bg-red-600 px-4 py-3 text-base font-semibold text-white shadow-lg transition-colors hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300 lg:absolute lg:right-[calc(var(--right-column)+1.5rem)]"
    >
      <span aria-hidden="true" class="text-base leading-none">+</span>
      Realizar reporte
    </button>

    <!-- Con el sheet cerrado del todo, este es el único modo de volver a abrirlo
         en móvil. En escritorio no existe: allá el panel es la barra lateral. -->
    <button
      type="button"
      id="sheet-toggle"
      hidden
      aria-label="Abrir el panel de puntos y novedades"
      aria-controls="sheet"
      class="sheet-toggle fixed right-4 z-[1050] inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-4 text-sm font-semibold text-slate-700 shadow-lg transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 lg:hidden"
    >
      <svg
        viewBox="0 0 20 20"
        aria-hidden="true"
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M3 5h14M3 10h14M3 15h14"></path>
      </svg>
      <!-- El mismo aviso ámbar de las pestañas: con el sheet cerrado el
           encabezado no se ve, y este botón es lo único que queda para
           enterarse. El borde lo separa del blanco del botón; es un borde y no
           un `ring` porque el `ring` de Tailwind es una `box-shadow`, y esa la
           usa el latido. -->
      <NewDot
        id="menu-dot"
        hidden
        class="absolute right-1 top-1 h-2.5 w-2.5 border-2 border-white"
      />
    </button>

    <!-- Con todo dibujado a la vez el mapa es ilegible: acá se decide qué pines
         quedan. El orden en el marcado importa —las reglas que bajan la pila
         cuando falta un botón son selectores `~` en `global.css`—, así que va
         entre «Ver panel» y «Centrar en mí». -->
    <button
      type="button"
      id="fab-filter"
      aria-label="Filtrar qué se ve en el mapa"
      aria-expanded="false"
      aria-controls="filters-card"
      class="fab-filter fixed right-4 z-[1050] inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-4 text-slate-700 shadow-lg transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 lg:absolute lg:right-[calc(var(--right-column)+1.5rem)]"
    >
      <svg
        viewBox="0 0 20 20"
        aria-hidden="true"
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3 5h14l-5.5 6.2V16l-3 1.5v-6.3L3 5z"></path>
      </svg>
    </button>

    <!-- Después de mover el mapa, el único camino de vuelta al punto propio. En
         escritorio también existe: la ubicación no es cosa de móvil. No lleva
         posición: `features/user-location.ts` lo monta en la esquina de arriba a
         la derecha del mapa, debajo del zoom, y de ahí en adelante la alineación
         la pone Leaflet. -->
    <button
      type="button"
      id="locate-me"
      aria-label="Centrar el mapa en mi ubicación"
      class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-4 text-slate-700 shadow-lg transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300"
    >
      <svg
        viewBox="0 0 20 20"
        aria-hidden="true"
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <circle cx="10" cy="10" r="4"></circle>
        <path d="M10 1v3M10 16v3M1 10h3M16 10h3"></path>
      </svg>
    </button>
  </div>
</Base>
