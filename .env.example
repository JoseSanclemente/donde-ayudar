# Supabase — Project Settings → API. Copiar a `.env` (no se commitea).
# El prefijo PUBLIC_ es lo que hace que Astro las inyecte en el bundle del
# navegador, que es donde se usan. Ambas son públicas; RLS es la protección.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ─── Docker / Jenkins (VPS `development` environment only) ─────────────────
# Unused locally and unused by the Netlify build — netlify.toml stays the
# only thing responsible for production. These three only matter inside the
# Jenkins Secret file `donde-ayudar-env-development` (see Jenkinsfile).
DEPLOY_USER=
DEPLOY_DIR=
DOCKER_SUBNET=
